# 复制为 .env 后务必替换全部示例密钥。
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-a-separate-32-byte-random-secret
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_SECONDS=28800
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_SECONDS=900
PAIRING_TIMEOUT_SECONDS=120
CAPTURE_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=5242880
SCREENSHOT_RETENTION_DAYS=7
RESULT_RETENTION_DAYS=90
